{
  "name": "writing-galaxy",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "写作星河：面向网文作者的本地写作软件（Electron 桌面版）",
  "author": "writer-fox",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:serve\"",
    "electron:serve": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:start": "electron .",
    "dist": "vue-tsc -b && vite build && electron-builder",
    "dist:win": "vue-tsc -b && vite build && electron-builder --win",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "3d-force-graph": "^1.80.0",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.writerfo.writinggalaxy",
    "productName": "写作星河",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/_selftest.js",
      "!electron/_integration.js",
      "!electron/_render.test.js",
      "!electron/_packtest.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "写作星河-α.${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
